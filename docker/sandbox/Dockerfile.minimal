# DeepAudit Agent Sandbox - 精简版
# 仅含 Phase 2 SAST 验证必需工具（semgrep/bandit/gitleaks）
# 后续按需扩展 Java/Node/Go 等

FROM python:3.12-slim

LABEL description="Minimal sandbox for Phase 2 SAST verification"

# 仅装最小系统工具 + Python 安全扫描工具
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Python 安全扫描工具（Phase 2 核心）
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    semgrep \
    bandit \
    safety \
    requests \
    httpx \
    aiohttp \
    beautifulsoup4 \
    lxml \
    pycryptodome \
    pyjwt

# 安装 Gitleaks（密钥泄露检测，二进制下载快）
RUN curl -L https://github.com/gitleaks/gitleaks/releases/download/v8.18.2/gitleaks_8.18.2_linux_x64.tar.gz -o /tmp/gitleaks.tar.gz && \
    tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks && \
    rm /tmp/gitleaks.tar.gz && \
    chmod +x /usr/local/bin/gitleaks

# 创建非 root 用户
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -m -s /bin/bash sandbox && \
    mkdir -p /workspace /tmp/sandbox && \
    chown -R sandbox:sandbox /workspace /tmp/sandbox

ENV HOME=/home/sandbox
ENV PATH=/home/sandbox/.local/bin:$PATH
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace

USER sandbox
WORKDIR /workspace
CMD ["/bin/bash"]
